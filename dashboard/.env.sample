# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Database connection (defaults for src/lib/settings.ts; the Settings page
# can override these at runtime via data/settings.json)
HX_DB_HOST=127.0.0.1
HX_DB_PORT=3306
HX_DB_NAME=hx_trades
HX_DB_USER=hx
HX_DB_PASSWORD=

# Legacy global X-Api-Key for POST /api/import: uploads sent with it are
# saved to the main admin. Empty = the indicator endpoints accept uploads
# without a key (also saved to the admin). Every user also has a personal
# key on their Settings page.
HX_API_KEY=

# Main admin login (user #1, owns all pre-multi-user data)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# Signs session cookies. Optional (derived from the admin login when empty),
# but set a long random value so changing the admin password doesn't sign
# everyone out:  openssl rand -hex 32
SESSION_SECRET=

# Public URL of the dashboard, e.g. https://trades.example.com
# (needed for Google sign-in redirects)
APP_URL=

# Email confirmation codes via Brevo (https://app.brevo.com -> SMTP & API ->
# API keys). MAIL_FROM_EMAIL must be a verified sender in Brevo. Without
# these, codes are only printed in the server log and an admin can confirm
# accounts manually on the Users page.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=HxTradeHelper

# "Continue with Google" (Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID, type Web application). Authorised
# redirect URI: ${APP_URL}/api/auth/google/callback. Leave empty to hide
# the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
